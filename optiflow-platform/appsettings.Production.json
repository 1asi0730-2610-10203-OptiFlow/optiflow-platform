{
  "ConnectionStrings": {
    "DefaultConnection": "server=%DATABASE_URL%;user=%DATABASE_USER%;password=%DATABASE_PASSWORD%;database=%DATABASE_SCHEMA%"
  },
  "AppSettings": {
    "JwtSettings": {
      "Secret": "%JWT_SECRET%",
      "ExpirationDays": 7
    },
    "FrontendUrl": "%FRONTEND_URL%"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
